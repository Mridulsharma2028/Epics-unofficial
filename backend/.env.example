# Copy to .env and adjust as needed.

# SQLite by default (zero setup). Swap for Postgres in production, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/aarogyanet
DATABASE_URL=sqlite:///./aarogyanet.db

# JWT
JWT_SECRET_KEY=dev-only-change-me-before-any-real-deployment
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Origins allowed to call this API (comma-separated). Must include wherever
# the Next.js frontend runs.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Seed the database with synthetic demo data matching frontend/lib/mockData.ts
# on first startup if tables are empty.
SEED_DEMO_DATA=true
